# Copy to .env and fill in. Never commit .env — it's gitignored on purpose.

# Phase 1 (capture + normalize) — required to run app/watcher.py, app/embedder.py,
# app/bot/telegram_bot.py against your real Supabase project + Telegram bot.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # Dashboard -> Project Settings -> API -> service_role (secret)
THEBRAIN_USER_ID=               # any stable UUID4 you generate ONCE and keep forever:
                                 #   python3 -c "import uuid; print(uuid.uuid4())"
TELEGRAM_BOT_TOKEN=             # from @BotFather

# Optional (Phase 1) — only needed once you switch embeddings/LLM to a
# local Ollama host (vault/_system/config.yaml `embeddings.provider`/`llm.*.provider`).
# OLLAMA_HOST=http://localhost:11434

# Optional (any phase) — force the mock llm()/embedding provider, no
# network or API key needed. Tests already set this for you.
# THEBRAIN_LLM_MOCK=1

# Phase 3 (CRM / NL invoicing)
# BUSINESS_KVK_NUMBER=
# BUSINESS_BTW_ID=
# BUSINESS_IBAN=
# BUSINESS_NAME=
# BUSINESS_ADDRESS=

# Phase 3 (Gmail comms log)
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
